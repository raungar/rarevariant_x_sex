rule get_outliers:
	input:
		ZSCORES=config["RAREDIR"]+"/preprocessing_v8eqtl/gtex_2017-06-05_normalized_expression_subsetted_{type}_{group}.txt.gz",
		genes_w_chrs=config["RAREDIR"]+"/preprocessing_v8eqtl/autosomal_gtf_protclinc_wchr.txt"
	params:
		ZTHRESH="{z_min}",
		NPHEN="{nphen_min}",
		TYPES="{type}"
	output:
		all=config["RAREDIR"] + "/outliers_v8eqtl/Current/outliers_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}.txt.gz",
		top=config["RAREDIR"] + "/outliers_v8eqtl/Current/outliersTOP_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}.txt.gz"
	
	shell:
		"""
		module load R
		Rscript /oak/stanford/groups/smontgom/raungar/Sex/Scripts/Outliers/call_outliers_mostextreme.R \
                    --Z.SCORES {input.ZSCORES}  --outfile_top {output.top} --outfile {output.all} \
	              --ZTHRESH {params.ZTHRESH} --N.PHEN {params.NPHEN} \
	              --gene_chr_table {input.genes_w_chrs} --chrtype {params.TYPES}
		"""

rule remove_excessive_outliers:
	input:
		all=config["RAREDIR"] + "/outliers_v8eqtl/Current/{outlierType}_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}.txt.gz"
	params:
		max_allowed_outliers=2
	output:
		outfile=config["RAREDIR"] + "/outliers_v8eqtl/OutliersFiltered/{outlierType}_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}.txt.gz"
	shell:
		"""
		module load R
		Rscript /oak/stanford/groups/smontgom/raungar/Sex/Scripts/Outliers/remove_excessive_outliers.R \\
			--infile {input.all} \
			--max_outliers {params.max_allowed_outliers} \
			--outfile {output.outfile}
		"""
