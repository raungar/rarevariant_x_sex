TYPES=["x","aut"]


rule all:
	input: 
		expand(config["RAREDIR"]+"/preprocessing_v8/gtex_2017-06-05_normalized_expression_subset.{type}.{group}.txt.gz",  group=GROUPS,type=TYPES)
