configfile: "/oak/stanford/groups/smontgom/raungar/Sex/Scripts/environment_paths.yaml"


import os, glob

FILES = [ os.path.basename(x) for x in glob.glob(config["FILESDIR"]+"/SexDEGs/*csv") ]
TISSUES=  list(set([ "".join(((x.split("-")[1]).split("."))[0]) for x in FILES]))
TISSUES="BREAST"
print(TISSUES)


rule all:
	input: 
		config["RAREDIR"]+"/sexdeg_v8/all_genes.txt",
		#expand(config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_rvs_{tissue}.txt.gz",
		#expand(config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_rvs_{tissue}.txt.gz",
		expand(config["RAREDIR"]+"/sexdeg_v8/rr_{tissue}.txt",
			tissue=TISSUES)
		#expand(config["RAREDIR"]+"/sexdeg_v8/smg_{tissue}.txt",tissue=TISSUES)

rule get_genes:
	input:
		config["RAREDIR"]+"/preprocessing_v8/gtex_2017-06-05_normalized_expression_gathered_both_half.regress.txt.gz"
	output:
		config["RAREDIR"]+"/sexdeg_v8/all_genes.txt"
	shell:
		"""
		less {input} | awk -F"\t" 'NR>1 {{print $2}}' | sort | uniq > {output}
		"""
rule overlap_genes_sexdegs:
	input:
		genes=config["RAREDIR"]+"/sexdeg_v8/all_genes.txt",
		sexdegs=config["FILESDIR"]+"/SexDEGs/sexDEGS-{tissue}.csv",
		myscript=config["SCRIPTSDIR"]+"/SexDeg/combine_allgenes_sexdegs.sh"
	output:
		config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_{tissue}.txt"
	shell:
		"""
		#echo "DN"
		sh {input.myscript} {input.genes} {input.sexdegs} {output}
		"""

rule add_RVs:
	input:
		#rvs=config["RAREDIR"]+"/features_v8/collapsed_maf_both_x.tsv.gz",
		rvs=config["RAREDIR"]+"/features_v8/collapsed_maf_both_linc_prot_x.tsv.gz",
		sexdegs=config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_{tissue}.txt",
		myscript=config["SCRIPTSDIR"]+"/SexDeg/intersect_sexdegs_rvs.py"
	output:
		config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_rvs_{tissue}.txt.gz"
	params:
		min=0,
		max=0.001
	log:
		config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_rvs_{tissue}.log"
	shell:
		"""
		python3 {input.myscript} --rvsites_file {input.rvs} \
		--genes_sexdegs {input.sexdegs} --outfile {output} \
		--logfile {log} --minmaf {params.min} --maxmaf {params.max}
		"""

rule get_frac_file:
	input: 
		rv_file=config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_rvs_{tissue}.txt.gz",
		script=config["SCRIPTSDIR"]+"/SexDeg/get_rr.sh"
	output:
		config["RAREDIR"]+"/sexdeg_v8/risktable_{tissue}.txt"
	shell:
		"""
		sh {input.script} {input.rv_file} {output}
		"""
		
rule calc_risk:
	input:
		infile=config["RAREDIR"]+"/sexdeg_v8/risktable_{tissue}.txt",
		rscript=config["SCRIPTSDIR"]+"/SexDeg/get_rr_epitab.R"
	output:
		config["RAREDIR"]+"/sexdeg_v8/rr_{tissue}.txt"
	shell:
		"""
		module load R
		Rscript {input.rscript} --infile {input.infile} --outfile {output}
		"""
	
