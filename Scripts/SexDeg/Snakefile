rule get_genes:
	input:
		config["RAREDIR"]+"/preprocessing_v8/gtex_2017-06-05_normalized_expression_gathered_both_half_regress.txt.gz"
	output:
		config["RAREDIR"]+"/sexdeg_v8/all_genes.txt"
	shell:
		"""
		less {input} | awk -F"\t" 'NR>1 {{print $2}}' | sort | uniq > {output}
		"""
rule get_chr:
	input:
		genelist=config["RAREDIR"]+"/sexdeg_v8/all_genes.txt",
		gtf=config["GTEX_GENES"],
		script=config["SCRIPTSDIR"]+"/SexDeg/gtf_to_genes_chr.py"
	output:
		outfile=config["RAREDIR"]+"/sexdeg_v8/all_genes_chr.txt"
	shell:
		"""
		python3 {input.script} --infile {input.genelist} --gtf {input.gtf} --outfile {output.outfile}
		"""

rule overlap_genes_sexdegs:
	input:
		genes=config["RAREDIR"]+"/sexdeg_v8/all_genes_chr.txt",
		sexdegs=config["FILESDIR"]+"/SexDEGs/sexDEGS-{tissue}.csv",
		myscript=config["SCRIPTSDIR"]+"/SexDeg/combine_allgenes_sexdegs.sh"
	params:
		abs_beta_min=beta_min
	output:
		config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_beta"+beta_min+"_{tissue}.txt"
	shell:
		"""
		#echo "DN"
		sh {input.myscript} {input.genes} {input.sexdegs} {output} {params}
		"""
rule red_overlap_reformat:
	input:
		config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_beta{beta_min}_{tissue}.txt"
	params:
		tissue_convert=lambda wildcards: tissue_dic[wildcards.tissue]
	output:
		temp(config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_beta{beta_min}_{tissue}_forcombine.txt")
	shell:
		"""
		###make file smaller by only givving ones that pass
		echo "{params.tissue_convert}"
		awk -F"\t" -v tiss={params.tissue_convert} '{{if($3 != 0){{print tiss"\t"$0}}}}' {input} > {output}
		"""
rule combine_sexdegs_reformatted:
	input:
		expand(config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_beta{{beta_min}}_{tissue}_forcombine.txt",tissue=TISSUES)
	output:
		config["RAREDIR"]+"/sexdeg_v8/alltissues_genes_sexDEGs_beta{beta_min}.txt.gz"
	shell:
		"""
		cat {input} | gzip -c > {output}
		"""

rule get_outliers:
	input:
		ZSCORES=config["RAREDIR"]+"/preprocessing_v8/gtex_2017-06-05_normalized_expression_subsetted_{type}_{group}.txt.gz",
		genes_w_chrs=config["RAREDIR"]+"/preprocessing_v8/both_gtf_protclinc_wchr.txt",
		sexdeg_file=config["RAREDIR"]+"/sexdeg_v8/alltissues_genes_sexDEGs_beta{beta_min}.txt.gz"
	params:
		ZTHRESH="{z_min}",
		NPHEN="{nphen_min}",
		TYPES="{type}"
	output:
		all=config["RAREDIR"] + "/sexdeg_v8/Outliers/outliers_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}_beta{beta_min}.txt.gz",
		top=config["RAREDIR"] + "/sexdeg_v8/Outliers/Current/outliersTOP_noglobal_medz_zthresh{z_min}_nphen{nphen_min}_{type}_{group}_beta{beta_min}.txt.gz"
	
	shell:
		"""
		module load R
		Rscript /oak/stanford/groups/smontgom/raungar/Sex/Scripts/SexDeg/call_outliers_sexdegs.R \
                    --Z.SCORES {input.ZSCORES}  --outfile_top {output.top} --outfile {output.all} \
	              --ZTHRESH {params.ZTHRESH} --N.PHEN {params.NPHEN} --sexdeg_file {input.sexdeg_file} \
	              --gene_chr_table {input.genes_w_chrs} --chrtype {params.TYPES}
		"""






rule join_variants_indtissues_sexdegs_x:
	input:
		#variant_file=config["RAREDIR"]+"/features_v8/collapsed_maf_both_aut_linc_prot.tsv.gz"
		variant_file=config["RAREDIR"]+"/features_v8/Collapsed/collapsed_x_CADDtypesGQ5BlacklistRemovedALL_cadd{cadd}.txt.gz",
		#ztissue=config["RAREDIR"]+"/preprocessing_v8/PEER_v8/"+tissue_dic["{tissue}"]+".{group}.peer.ztrans.txt",
		#outlier_file=config["RAREDIR"]+"/outliers_v8/outliers_zthresh{zmin}_nphen{nphen}_globalOutliersRemoved_aut_{group}.txt",
		sexdegs=config["RAREDIR"]+"/sexdeg_v8/all_genes_sexDEGs_beta"+beta_min+"_{tissue}.txt"
	wildcard_constraints:
		chrNUM="x"
	params:
		linc_prot_only_dir=config["RAREDIR"]+"/features_v8/GTF_lnc_protcod_only",
		ztissue_prefix=config["RAREDIR"]+"/preprocessing_v8/PEER_v8",
		ztissue_suffix=".{group}.peer.ztrans.txt",
		tissue_expression=lambda wcs: tissue_dic[wcs.tissue],
		chr="X"	
	output:
		outfile=config["RAREDIR"]+"/sexdeg_v8/CombinedSingleTissue/x_beta"+beta_min+"_{tissue}_{group}_cadd{cadd}_linc_prot.txt.gz"
	shell:
		"""
