def get_sextype(wildcards):
	x=wildcards.actual_or_null
	#preprocessing_v8
	if(x=="preprocessing_v8"):
		return "SEX"
	elif(x=="nullshuffled_v8"):
		return "SexScrambled"
	else:
		return "ERROR"
def get_md(wildcards):
	x=wildcards.actual_or_null
	#preprocessing_v8
	if(x=="preprocessing_v8"):
		return config["GTEX_SUBJECTSv8"]
	elif(x=="nullshuffled_v8"):
		return config["RAREDIR"]+"/analysis_v8/continuous/Assignments/test_train.txt"
	else:
		return "ERROR"

#since i dont know how many factors, this will get it for me!
def get_peer(wildcards):
	counts_dir=wildcards.actual_or_null
	this_sex=wildcards.this_sex
	this_tissue=wildcards.tissue
	this_file=glob.glob(config["RAREDIR"]+"/"+counts_dir+"/PEER_v8/*"+this_tissue+"_Factors*"+"_"+this_sex+"/factors.tsv")
	return this_file

