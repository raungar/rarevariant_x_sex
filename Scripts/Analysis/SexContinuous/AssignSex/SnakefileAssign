#splits into SUBJID/SEX for a gievn alpha for use for md
rule prepare_md:
	input:
		preds=config["RAREDIR"]+"/analysis_v8/continuous/Assignments/{tissue}-{actual_or_null}-preds-{subgroup}.txt"
	params:
		alpha="{alpha}"
	output:
		outfile=config["RAREDIR"]+"/analysis_v8/continuous/Regressions/md_{tissue}-{actual_or_null}-{alpha}-{subgroup}.txt"
	shell:
		"""
		col=`echo "{params.alpha} * 10 +2" | bc -l  | awk -F"\." '{{print $1}}'`
		cat <(echo -e "SUBJID\tSEX") <(cat {input.preds} | tail -n +2 | awk -F"\t" -v col=$col '{{print $1"\t"$col}}' ) > {output}
		"""

